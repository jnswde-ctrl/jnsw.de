{
  "name": "JNSW.DE",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --port 3000",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "validate:yaml": "node scripts/validate-yaml.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.7.4",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@cloudflare/vite-plugin": "^1.52.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/nextjs-vite": "^10.5.9",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-storybook": "^10.5.9",
    "jsdom": "^26.1.0",
    "miniflare": "^5.20260811.1-alpha",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "latest",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "storybook": "^10.5.9",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.6",
    "vite": "8.2.1",
    "vitest": "latest",
    "wrangler": "^4.123.0",
    "yaml": "^2.9.0"
  },
  "type": "module",
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.27.7": true,
    "workerd@1.20260801.1": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
